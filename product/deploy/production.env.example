# Operator supplies actual values in a protected file outside the release.
# Do not enable test mode or seed synthetic identities in a company environment.
APP_MODE=production
DATABASE_URL=
WORKBOARD_STORAGE=
WORKBOARD_HOSTS=
WORKBOARD_DEPARTMENT=系統架構科
LDAP_HOST=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
