# Exact distinguished names of direct AD groups. Nested groups not yet supported.
LDAP_ROLE_GROUPS={}
# JSON argv; the private uploaded file path is appended as the final argument.
# Production without an actual successful scanner quarantines attachments.
WORKBOARD_SCANNER=
